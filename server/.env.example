PORT=4010
CLIENT_ORIGIN=http://localhost:5173

# Postgres (docker-compose.yml at repo root exposes it on 5440)
DATABASE_URL=postgresql://vendor:vendor@localhost:5440/vendor_verify?schema=public

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenCorporates — https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_TOKEN=

# Resend — https://resend.com/api-keys
# Sandbox sender onboarding@resend.dev can only deliver to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=Vendor Verification <onboarding@resend.dev>
